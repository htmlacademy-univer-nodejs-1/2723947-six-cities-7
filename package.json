{
  "name": "six-cities",
  "version": "4.0.0",
  "description": "Проект «Шесть городов» от HTML Academy",
  "keywords": [
    "rest",
    "api",
    "node.js"
  ],
  "main": "main.js",
  "scripts": {
    "start": "npm run build && node ./dist/main.js",
    "cli": "npm run build && node ./dist/cli.js",
    "build": "npm run clean && npm run compile",
    "lint": "eslint src/ --ext .ts",
    "compile": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "ts": "ts-node",
    "mock:server": "json-server --watch mocks/mock-server-data.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start:pretty": "npm run build && bash -o pipefail -c \"node ./dist/main.js | pino-pretty\""
  },
  "devDependencies": {
    "@types/convict": "^6.1.6",
    "@types/convict-format-with-validator": "^6.0.6",
    "@types/node": "18.16.3",
    "@typescript-eslint/eslint-plugin": "5.46.0",
    "@typescript-eslint/parser": "5.46.0",
    "eslint": "8.39.0",
    "eslint-config-htmlacademy": "9.1.1",
    "json-server": "^0.17.4",
    "pino-pretty": "^13.2.0",
    "rimraf": "3.0.2",
    "ts-node": "10.9.1",
    "typescript": "4.9.5"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "chalk": "^5.6.2",
    "convict": "^6.2.5",
    "convict-format-with-validator": "^6.2.0",
    "dotenv": "^16.6.1",
    "inversify": "^6.0.1",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.1.14"
  }
}
